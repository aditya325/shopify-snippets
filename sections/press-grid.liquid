{%- liquid
  assign press_cta_label = section.settings.press_cta_label

  # The archive is a separate blog, so its address cannot derive from this one — it is picked
  assign press_cta_url = section.settings.press_cta_url
  if press_cta_url == blank
    assign press_cta_url = section.settings.press_cta_blog.url
  endif

  assign press_mirrored = section.settings.press_mirrored

  assign press_lead = section.blocks | where: 'type', 'press-lead-card' | first
  assign press_items = section.blocks | where: 'type', 'press-card'
-%}

{%- if section.blocks.size > 0 -%}
  <div
    class="press-grid mb-[var(--press-bottom-mobile)] mt-[var(--press-top-mobile)] lg:mb-[var(--press-bottom-desktop)] lg:mt-[var(--press-top-desktop)]"
    style="
      --press-top-mobile: {{ section.settings.press_top_mobile }}px;
      --press-bottom-mobile: {{ section.settings.press_bottom_mobile }}px;
      --press-top-desktop: {{ section.settings.press_top_desktop }}px;
      --press-bottom-desktop: {{ section.settings.press_bottom_desktop }}px;
    "
  >
    <div class="page-width">
      {%- render 'press-grid-block',
        block_lead: press_lead,
        block_items: press_items,
        block_kind: 'block',
        block_mirrored: press_mirrored
      -%}

      {%- if press_cta_label != blank and press_cta_url != blank -%}
        <div class="press-grid__cta mt-8 flex justify-center">
          {%- render 'button',
            label: press_cta_label,
            link: press_cta_url,
            variant: 'primary',
            icon: 'arrow-right',
            icon_class: 'h-[22px] w-[22px] shrink-0 [stroke-width:1.3]',
            class_name: 'press-grid__cta-button h-[52px] w-full gap-2.5 rounded-xl text-[18px]/[28px] font-semibold lg:w-[260px]'
          -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Press Grid",
  "class": "press-grid-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "press_cta_label",
      "label": "Press CTA Label",
      "default": "View All News"
    },
    {
      "type": "blog",
      "id": "press_cta_blog",
      "label": "Press CTA Blog",
      "info": "Blog the CTA opens — the News blog holding the full archive."
    },
    {
      "type": "url",
      "id": "press_cta_url",
      "label": "Press CTA Url",
      "info": "Optional. Overrides the blog above."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "checkbox",
      "id": "press_mirrored",
      "label": "Press Mirrored",
      "info": "Places the featured cell on the right. Leave off for the first grid on a page and alternate below it.",
      "default": false
    },
    {
      "type": "range",
      "id": "press_top_mobile",
      "label": "Space Above (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "press_bottom_mobile",
      "label": "Space Below (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "press_top_desktop",
      "label": "Space Above (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "press_bottom_desktop",
      "label": "Space Below (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "press-lead-card",
      "name": "Press Lead Card",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "card_title",
          "label": "Card Title"
        },
        {
          "type": "text",
          "id": "card_publisher",
          "label": "Card Publisher"
        },
        {
          "type": "text",
          "id": "card_date",
          "label": "Card Date",
          "info": "Shown as typed. The lead card shows the year in the design, e.g. Oct 12, 2025."
        },
        {
          "type": "url",
          "id": "card_url",
          "label": "Card Url",
          "info": "External publisher link. The card is unlinked while this is blank."
        }
      ]
    },
    {
      "type": "press-card",
      "name": "Press Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "card_title",
          "label": "Card Title"
        },
        {
          "type": "text",
          "id": "card_publisher",
          "label": "Card Publisher"
        },
        {
          "type": "text",
          "id": "card_date",
          "label": "Card Date",
          "info": "Shown as typed, e.g. Sep 28."
        },
        {
          "type": "url",
          "id": "card_url",
          "label": "Card Url",
          "info": "External publisher link. The card is unlinked while this is blank."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Press Grid",
      "blocks": [
        { "type": "press-lead-card", "settings": { "card_title": "How Amrutanjan is Reimagining Ayurvedic Wisdom for Gen Z Wellness", "card_publisher": "Economic Times", "card_date": "Oct 12, 2025" } },
        { "type": "press-card", "settings": { "card_title": "The Science of Better Sleep: A New Standard", "card_publisher": "Health Shots", "card_date": "Sep 28" } },
        { "type": "press-card", "settings": { "card_title": "Building a 130-Year-Old Modern Startup", "card_publisher": "Economic Times", "card_date": "Sep 15" } },
        { "type": "press-card", "settings": { "card_title": "Sustainable Packaging: The New Frontier", "card_publisher": "Times of India", "card_date": "Aug 30" } },
        { "type": "press-card", "settings": { "card_title": "Amrutanjan: A Case Study in Brand Loyalty", "card_publisher": "Business Insider", "card_date": "Aug 22" } },
        { "type": "press-card", "settings": { "card_title": "Top 5 Rituals for Everyday Energy", "card_publisher": "Femina", "card_date": "Aug 05" } }
      ]
    }
  ]
}
{% endschema %}
