{%- liquid
  assign header_scroll_desk = section.settings.header_scroll_bg_desk | default: 'rgba(70,110,46,0.3)'
  assign header_scroll_mob = section.settings.header_scroll_bg_mob | default: 'rgba(70,110,46,0.2)'

  assign panelled_handles = ''
  for block in section.blocks
    capture block_row_map
      render 'mega-menu-row-map', block_type: block.type
    endcapture
    assign block_row_settings = block_row_map | strip | split: '|' | first | split: ','
    assign block_row_count = 0
    for setting_id in block_row_settings
      assign block_row_count = block_row_count | plus: block.settings[setting_id].size
    endfor
    assign block_parent = block.settings.mega_parent_handle | handleize
    if block_row_count > 0 and block_parent != blank
      assign panelled_handles = panelled_handles | append: ',' | append: block_parent | append: ','
    endif
  endfor
-%}

<header
  class="header sticky top-0 z-50 w-full bg-background transition-all duration-300"
  id="main-header"
  data-header-scrolled="false"
  style="--header-scroll-bg-desk: {{ header_scroll_desk }}; --header-scroll-bg-mob: {{ header_scroll_mob }};"
>
  {% render 'header-desktop', section: section, panelled_handles: panelled_handles %}

  {% render 'header-mobile', section: section, panelled_handles: panelled_handles %}

  {%- render 'mega-menu-orphan-notice', section: section -%}

  {%- render 'mega-menu-panel', section: section -%}
</header>

<div
  class="pointer-events-none fixed inset-0 z-40 bg-black/20 opacity-0 backdrop-blur-[6px] transition-opacity duration-[250ms] ease-out motion-reduce:transition-none max-lg:hidden data-[open=true]:opacity-100"
  data-mega-backdrop
  data-open="false"
  aria-hidden="true"
></div>

{% render 'search-modal' %}

<script src="{{ 'accordion.js' | asset_url }}" defer></script>
<script src="{{ 'header-javascript.js' | asset_url }}" defer></script>
<script src="{{ 'search-recent-searches.js' | asset_url }}" defer></script>
<script src="{{ 'search-modal.js' | asset_url }}" defer></script>
<script src="{{ 'predictive-search.js' | asset_url }}" defer></script>

