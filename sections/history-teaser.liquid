{%- liquid
  assign teaser_image = section.settings.teaser_image
  assign teaser_heading = section.settings.teaser_heading
  assign teaser_desc = section.settings.teaser_desc
  assign teaser_heading_plain = teaser_heading | strip_html | strip
  assign teaser_desc_plain = teaser_desc | strip_html | strip

  assign teaser_cta_label = section.settings.teaser_cta_label
  assign teaser_cta_link = section.settings.teaser_cta_link

  assign teaser_has_cta = false
  if teaser_cta_label != blank and teaser_cta_link != blank
    assign teaser_has_cta = true
  endif
-%}

{%- if teaser_image != blank or teaser_heading_plain != blank or teaser_desc_plain != blank or teaser_has_cta -%}
  <div
    class="history-teaser mb-[var(--teaser-bot-mob)] mt-[var(--teaser-top-mob)] lg:mb-[var(--teaser-bot-desk)] lg:mt-[var(--teaser-top-desk)]"
    style="
      --teaser-top-mob: {{ section.settings.teaser_top_mobile }}px;
      --teaser-bot-mob: {{ section.settings.teaser_bottom_mobile }}px;
      --teaser-top-desk: {{ section.settings.teaser_top_desktop }}px;
      --teaser-bot-desk: {{ section.settings.teaser_bottom_desktop }}px;
    "
  >
    <div class="page-width">
      <div
        class="history-teaser__card flex flex-col gap-3 rounded-[15px] border-2 border-primary bg-primary/20 p-4 lg:flex-row lg:items-center lg:gap-10 lg:rounded-[20px] lg:p-10"
      >
        {%- if teaser_image != blank -%}
          <div
            class="history-teaser__media size-[120px] shrink-0 overflow-hidden rounded-full shadow-[0px_1px_2px_0px_rgba(0,0,0,0.08)] lg:size-[260px]"
          >
            {%- render 'image',
              image: teaser_image,
              alt: '',
              class_name: 'h-full w-full object-cover',
              decoding: 'async',
              responsive_widths: '390:240,1024:520'
            -%}
          </div>
        {%- endif -%}

        <div class="history-teaser__content flex min-w-0 flex-1 flex-col gap-6">
          {%- if teaser_heading_plain != blank or teaser_desc_plain != blank -%}
            <div class="history-teaser__text flex flex-col gap-3">
              {%- if teaser_heading_plain != blank -%}
                {%- render 'section-header', heading: teaser_heading, class_name: 'text-left' -%}
              {%- endif -%}

              {%- if teaser_desc_plain != blank -%}
                <div
                  class="history-teaser__desc font-secondary text-[16px]/[22px] font-medium tracking-[-0.18px] text-[#2b4934] lg:text-[20px]/[30px] lg:tracking-[-0.15px]"
                >
                  {{ teaser_desc }}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if teaser_has_cta -%}
            {%- render 'button',
              label: teaser_cta_label,
              link: teaser_cta_link,
              variant: 'primary',
              size: 'lg',
              with_arrow: true,
              icon_class: 'size-3.5 shrink-0',
              class_name: 'w-full rounded-lg lg:h-[52px] lg:w-[250px] lg:rounded-xl lg:text-subheading-d'
            -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "History Teaser",
  "class": "history-teaser-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "teaser_image",
      "label": "Teaser Image",
      "info": "The brand seal. Shown as a circle."
    },
    {
      "type": "richtext",
      "id": "teaser_heading",
      "label": "Teaser Heading"
    },
    {
      "type": "richtext",
      "id": "teaser_desc",
      "label": "Teaser Description"
    },
    {
      "type": "text",
      "id": "teaser_cta_label",
      "label": "Teaser CTA Label",
      "default": "Our History"
    },
    {
      "type": "url",
      "id": "teaser_cta_link",
      "label": "Teaser CTA Link",
      "info": "Point this at the History page. The button is hidden when empty."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "teaser_top_mobile",
      "label": "Space Above (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "teaser_bottom_mobile",
      "label": "Space Below (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "teaser_top_desktop",
      "label": "Space Above (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "teaser_bottom_desktop",
      "label": "Space Below (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "History Teaser"
    }
  ]
}
{% endschema %}
