{{ 'facets-stylesheet.css' | asset_url | stylesheet_tag: preload: true }}

{%- liquid
  assign products_per_page = section.settings.products_per_page | default: 16
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign columns_mobile = section.settings.columns_mobile | default: 2

  case columns_desktop
    when 4
      assign grid_class_desktop = 'lg:grid-cols-4'
    when 5
      assign grid_class_desktop = 'lg:grid-cols-5'
    else
      assign grid_class_desktop = 'lg:grid-cols-3'
  endcase

  case columns_mobile
    when 1
      assign grid_class_mobile = 'grid-cols-1'
    when 3
      assign grid_class_mobile = 'grid-cols-3'
    else
      assign grid_class_mobile = 'grid-cols-2'
  endcase

  assign current_sort = collection.sort_by | default: collection.default_sort_by

  assign has_filters = false
  if collection.filters.size > 0
    assign has_filters = true
  endif

  assign active_filter_count = 0
  for filter in collection.filters
    for value in filter.active_values
      assign active_filter_count = active_filter_count | plus: 1
    endfor
    if filter.type == 'price_range'
      if filter.min_value.value or filter.max_value.value
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endif
  endfor

  assign collection_count_label = 'facets.products_count' | t: count: collection.products_count
-%}

<div
  class="collection-page my-6 lg:my-8"
  data-collection-section
  data-section-id="{{ section.id }}"
>
  <div class="page-width">
    <div class="collection-page__breadcrumbs py-2.5 lg:py-3" data-active-filters-container>
      {%- render 'breadcrumbs', breadcrumb_current: collection.title, breadcrumb_count: collection_count_label -%}
    </div>

    <div class="collection-page__header flex flex-col gap-1.5 pb-5 pt-2.5 lg:pb-6 lg:pt-5">
      <h1 class="font-primary text-[24px] font-semibold leading-8 tracking-[-0.2px] text-foreground lg:font-bold">
        {{ collection.title }}
      </h1>
      {%- if collection.description != blank -%}
        <div class="max-w-2xl font-secondary text-[14px] leading-6 text-muted lg:text-[16px]">
          {{ collection.description }}
        </div>
      {%- endif -%}
    </div>

    <div class="collection-page__results flex gap-5 lg:gap-8">
      {%- if has_filters -%}
        <aside
          class="hidden shrink-0 lg:sticky lg:top-[126px] lg:block lg:max-h-[calc(100vh-142px)] lg:basis-[280px] lg:self-start lg:overflow-y-auto lg:pr-5"
          data-filters-sidebar
        >
          <div class="flex items-center justify-between gap-5 pb-5">
            <span class="inline-flex items-center gap-2 font-secondary text-[18px] font-medium leading-7 text-primary">
              {%- render 'icon-filter-lines', size: 20, class: 'h-5 w-5' -%}
              {{ 'facets.filters_with_count' | t: count: active_filter_count }}
            </span>
            {%- if active_filter_count > 0 -%}
              <a
                href="{{ collection.url }}"
                class="shrink-0 rounded-md border-[0.5px] border-primary px-3 py-2 font-secondary text-[14px] font-semibold leading-[21px] text-primary transition-colors [@media(hover:hover)]:hover:bg-primary/10"
                data-clear-filters
              >
                {{ 'facets.clear_all' | t }}
              </a>
            {%- endif -%}
          </div>
          {%- render 'facet-filters', filter_source: collection -%}
        </aside>
      {%- endif -%}

      <div class="flex min-w-0 flex-1 flex-col">
        <div
          class="facet-toolbar sticky top-[66px] z-30 flex items-center justify-between gap-4 border-b border-[#f5f5f5] bg-background py-3 lg:static lg:z-auto lg:justify-end lg:border-b-0 lg:pb-5 lg:pt-0"
          data-collection-toolbar
        >
          {%- if has_filters -%}
            <button
              type="button"
              class="inline-flex items-center gap-2 font-secondary text-[14px] font-semibold leading-[21px] text-primary lg:hidden"
              data-filter-toggle
              aria-expanded="false"
              aria-controls="collection-filter-drawer"
            >
              {%- render 'icon-filter-lines', size: 16, class: 'h-4 w-4' -%}
              {{ 'facets.filters_with_count' | t: count: active_filter_count }}
            </button>
          {%- endif -%}

          <button
            type="button"
            class="inline-flex items-center gap-2 font-secondary text-[14px] font-semibold leading-[21px] text-primary lg:hidden"
            data-sort-toggle
            aria-expanded="false"
          >
            {%- render 'icon-sort', size: 16, class: 'h-4 w-4' -%}
            {{ 'facets.sort' | t }}
          </button>

          <div class="relative hidden items-center gap-2 lg:flex" data-facet-sort>
            <span class="inline-flex shrink-0 items-center gap-2 font-secondary text-[16px] font-semibold leading-6 text-primary">
              {%- render 'icon-sort', size: 20, class: 'h-5 w-5' -%}
              {{ 'facets.sort' | t }}
            </span>

            {%- liquid
              assign current_sort_name = ''
              for option in collection.sort_options
                if option.value == current_sort
                  assign current_sort_name = option.name
                endif
              endfor
            -%}

            <button
              type="button"
              class="inline-flex items-center gap-2 rounded-lg px-1 py-1 font-secondary text-[16px] leading-6 text-[#525252] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary [@media(hover:hover)]:hover:text-foreground"
              data-facet-sort-toggle
              aria-expanded="false"
              aria-haspopup="listbox"
            >
              <span data-facet-sort-label>{{ current_sort_name }}</span>
              {%- render 'icon-chevron-down', size: 16, class: 'h-4 w-4 shrink-0' -%}
            </button>

            <div
              class="invisible absolute right-0 top-full z-40 mt-2 min-w-[220px] -translate-y-1 overflow-hidden rounded-xl border border-[#f5f5f5] bg-background opacity-0 shadow-lg transition-all duration-200 ease-out motion-reduce:transition-none"
              data-facet-sort-menu
              role="listbox"
            >
              {%- for option in collection.sort_options -%}
                {%- assign is_current = false -%}
                {%- if option.value == current_sort -%}
                  {%- assign is_current = true -%}
                {%- endif -%}
                <button
                  type="button"
                  role="option"
                  class="flex w-full items-center justify-between gap-3 border-b border-[#f5f5f5] px-4 py-3 text-left font-secondary text-[14px] leading-[21px] transition-colors last:border-b-0 [@media(hover:hover)]:hover:bg-cream-alt {% if is_current %}font-medium text-primary{% else %}text-[#282828]{% endif %}"
                  data-facet-sort-option
                  data-value="{{ option.value }}"
                  data-label="{{ option.name | escape }}"
                  aria-selected="{{ is_current }}"
                >
                  <span>{{ option.name }}</span>
                  {%- if is_current -%}
                    {%- render 'icon-checkmark', size: 16, class: 'h-4 w-4 shrink-0' -%}
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>

            <select id="collection-sort" class="sr-only" data-collection-sort tabindex="-1" aria-hidden="true">
              {%- for option in collection.sort_options -%}
                <option
                  value="{{ option.value }}"
                  {% if option.value == current_sort %}
                    selected
                  {% endif %}
                >
                  {{ option.name }}
                </option>
              {%- endfor -%}
            </select>
          </div>
        </div>

        <div class="relative transition-opacity duration-300" data-collection-products>
          <div class="absolute inset-0 z-20 hidden bg-background/60" data-collection-loader></div>

          {% paginate collection.products by products_per_page %}
            {%- if collection.products.size == 0 -%}
              <div class="flex min-h-[300px] flex-col items-center justify-center text-center">
                <p class="mb-4 font-secondary text-[16px] text-muted">{{ 'collections.no_products' | t }}</p>
                {%- if has_filters -%}
                  <a
                    href="{{ collection.url }}"
                    class="font-secondary text-[14px] underline transition-colors hover:text-foreground"
                    data-clear-filters
                  >
                    {{ 'facets.clear_all' | t }}
                  </a>
                {%- endif -%}
              </div>
            {%- else -%}
              {%- liquid
                assign product_total = collection.products.size
                assign mobile_break = columns_mobile | at_most: product_total
                assign desktop_break = columns_desktop | at_most: product_total
              -%}

              <div class="grid {{ grid_class_mobile }} gap-2.5 lg:gap-5 {{ grid_class_desktop }}" data-facet-grid>
                {%- assign product_index = 0 -%}
                {%- for product in collection.products -%}
                  {%- assign product_index = product_index | plus: 1 -%}
                  {%- render 'product-card', card_product: product -%}

                  {%- if section.settings.show_concern_bar and paginate.current_page == 1 -%}
                    {%- if product_index == mobile_break -%}
                      <div class="col-span-full my-2 lg:my-0 lg:hidden">
                        {%- render 'concern-bar', filter_source: collection -%}
                      </div>
                    {%- endif -%}
                    {%- if product_index == desktop_break -%}
                      <div class="col-span-full hidden lg:block">
                        {%- render 'concern-bar', filter_source: collection -%}
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- if paginate.pages > 1 -%}
                <div class="mt-8" data-facet-pagination>
                  {%- render 'pagination', paginate: paginate -%}
                </div>
              {%- endif -%}

              {%- render 'facet-load-more', paginate: paginate -%}
            {%- endif -%}
          {% endpaginate %}
        </div>
      </div>
    </div>
  </div>
</div>

{%- if has_filters -%}
  <div class="fixed inset-0 z-[100] hidden" id="collection-filter-drawer" data-filter-drawer>
    <div class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300" data-filter-overlay></div>

    <div
      class="absolute inset-x-0 bottom-0 flex max-h-[85vh] translate-y-full flex-col rounded-t-md bg-background shadow-xl transition-transform duration-300"
      data-filter-panel
      data-sheet
    >
      <div class="flex shrink-0 flex-col gap-3 px-5 pb-4 pt-3">
        <span
          class="mx-auto -my-2 flex h-5 w-16 shrink-0 cursor-grab touch-none items-center justify-center active:cursor-grabbing"
          data-sheet-handle
        >
          <span class="h-1 w-10 rounded-sm bg-[#dcd7ce]"></span>
        </span>
        <div class="flex items-center gap-2.5">
          {%- render 'icon-filter-lines', size: 18, class: 'h-[18px] w-[18px] text-foreground' -%}
          <h2 class="font-secondary text-[18px] font-medium leading-[23.4px] text-foreground">
            {{ 'facets.filters' | t }}
          </h2>
          <button
            type="button"
            class="-mr-1 ml-auto flex h-9 w-9 items-center justify-center text-foreground transition-colors hover:text-muted"
            data-filter-close
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {%- render 'icon-close', size: 18, class: 'h-[18px] w-[18px]' -%}
          </button>
        </div>
      </div>

      <div class="min-h-0 flex-1 overflow-y-auto">
        {%- render 'facet-filters', filter_source: collection, filter_variant: 'sheet' -%}
      </div>

      <div class="flex shrink-0 items-center gap-3 border-t border-[#ece8e1] px-5 py-3.5">
        <a
          href="{{ collection.url }}"
          class="inline-flex shrink-0 items-center justify-center rounded-[10px] border-[0.5px] border-primary px-5 py-3 font-secondary text-[13px] font-medium leading-[16.9px] text-primary transition-colors [@media(hover:hover)]:hover:bg-primary/10"
          data-clear-filters
        >
          {{ 'facets.clear_all' | t }}
        </a>
        <button
          type="button"
          class="inline-flex flex-1 items-center justify-center rounded-[10px] bg-primary px-4 py-3 font-secondary text-[13px] font-medium leading-[16.9px] text-primary-foreground transition-colors [@media(hover:hover)]:hover:bg-green-dark"
          data-filter-close
        >
          {{ 'facets.show_products' | t: count: collection.products_count }}
        </button>
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%} Mobile sort sheet {%- endcomment -%}
{%- render 'facet-sort-sheet', filter_source: collection, current_sort: current_sort -%}

<script src="{{ 'collection.js' | asset_url }}" defer></script>
<script src="{{ 'facets.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Collection",
  "class": "collection-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_concern_bar",
      "label": "Show Concern Bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    }
  ]
}
{% endschema %}
