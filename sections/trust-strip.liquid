{%- liquid
  assign trust_live_count = 0
  for block in section.blocks
    assign trust_title_plain = block.settings.item_title | strip_html | strip
    if trust_title_plain != blank
      assign trust_live_count = trust_live_count | plus: 1
    endif
  endfor
-%}

{%- if trust_live_count > 0 -%}
  <div
    class="trust-strip mb-[var(--trust-bottom-mobile)] mt-[var(--trust-top-mobile)] lg:mb-[var(--trust-bottom-desktop)] lg:mt-[var(--trust-top-desktop)] 2xl:mx-auto 2xl:max-w-[1440px]"
    style="
      --trust-top-mobile: {{ section.settings.trust_top_mobile }}px;
      --trust-bottom-mobile: {{ section.settings.trust_bottom_mobile }}px;
      --trust-top-desktop: {{ section.settings.trust_top_desktop }}px;
      --trust-bottom-desktop: {{ section.settings.trust_bottom_desktop }}px;
    "
  >
    <div class="trust-strip__band bg-background py-6 lg:py-8">
      <div class="trust-strip__row flex">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'trust-item' -%}
              {%- assign trust_title_plain = block.settings.item_title | strip_html | strip -%}
              {%- if trust_title_plain != blank -%}
                {%- render 'trust-item', block: block -%}
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Trust Strip",
  "class": "trust-strip-section",
  "settings": [
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "trust_top_mobile",
      "label": "Space above (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "trust_bottom_mobile",
      "label": "Space below (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "trust_top_desktop",
      "label": "Space above (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "trust_bottom_desktop",
      "label": "Space below (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "trust-item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "item_icon",
          "label": "Icon",
          "info": "The certification mark. Example: an ISO seal. Leave empty to show the label on its own."
        },
        {
          "type": "richtext",
          "id": "item_title",
          "label": "Title",
          "info": "Text under the icon. Enter starts a new line on mobile. Lines join on desktop. Example: ISO Certified. Leave empty to hide this item."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Strip",
      "blocks": [
        { "type": "trust-item", "settings": { "item_title": "<p>ISO<br/>Certified</p>" } },
        { "type": "trust-item", "settings": { "item_title": "<p>Ayush<br/>Approved</p>" } },
        { "type": "trust-item", "settings": { "item_title": "<p>Fast<br/>Acting</p>" } },
        { "type": "trust-item", "settings": { "item_title": "<p>130+<br/>Years</p>" } }
      ]
    }
  ]
}
{% endschema %}
