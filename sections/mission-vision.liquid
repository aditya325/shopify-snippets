{%- liquid
  assign mission_live_count = 0
  for block in section.blocks
    assign mission_desc_plain = block.settings.pillar_desc | strip_html | strip
    if block.settings.pillar_tag != blank or mission_desc_plain != blank
      assign mission_live_count = mission_live_count | plus: 1
    endif
  endfor
-%}

{%- if mission_live_count > 0 -%}
  <div
    class="mission-vision mb-[var(--mission-bot-mob)] mt-[var(--mission-top-mob)] lg:mb-[var(--mission-bot-desk)] lg:mt-[var(--mission-top-desk)]"
    style="
      --mission-top-mob: {{ section.settings.mission_top_mobile }}px;
      --mission-bot-mob: {{ section.settings.mission_bottom_mobile }}px;
      --mission-top-desk: {{ section.settings.mission_top_desktop }}px;
      --mission-bot-desk: {{ section.settings.mission_bottom_desktop }}px;
    "
  >
    <div class="mission-vision__row page-width flex flex-col gap-4 lg:flex-row lg:gap-5">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'mission-pillar' -%}
            {%- render 'mission-pillar', block: block -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Mission Vision",
  "class": "mission-vision-section",
  "settings": [
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "mission_top_mobile",
      "label": "Space Above (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mission_bottom_mobile",
      "label": "Space Below (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mission_top_desktop",
      "label": "Space Above (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mission_bottom_desktop",
      "label": "Space Below (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "mission-pillar",
      "name": "Mission Pillar",
      "settings": [
        {
          "type": "text",
          "id": "pillar_tag",
          "label": "Pillar Tag",
          "info": "Short label, rendered uppercase. Example: Our Mission."
        },
        {
          "type": "richtext",
          "id": "pillar_desc",
          "label": "Pillar Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mission Vision",
      "blocks": [
        {
          "type": "mission-pillar",
          "settings": {
            "pillar_tag": "Our Mission",
            "pillar_desc": "<p>To make trusted, effective, and accessible wellness products that support Indian families across every stage of life — from everyday aches to long-term wellbeing. We are here not just when you are sick, but every single day.</p>"
          }
        },
        {
          "type": "mission-pillar",
          "settings": {
            "pillar_tag": "Our Vision",
            "pillar_desc": "<p>To be present in every Indian home — a brand families reach for instinctively, pass down across generations, and trust completely. We envision a healthier India where wellness is simple, honest, and within reach for everyone.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
