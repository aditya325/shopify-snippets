{%- liquid
  assign gallery_heading = section.settings.gallery_heading
  assign gallery_heading_plain = gallery_heading | strip_html | strip

  assign gallery_live_count = 0
  for block in section.blocks
    if block.settings.tile_image != blank or block.settings.tile_caption != blank
      assign gallery_live_count = gallery_live_count | plus: 1
    endif
  endfor
-%}

{%- if gallery_heading_plain != blank or gallery_live_count > 0 -%}
  <div
    class="manufacturing-gallery mb-[var(--gallery-bot-mob)] mt-[var(--gallery-top-mob)] lg:mb-[var(--gallery-bot-desk)] lg:mt-[var(--gallery-top-desk)]"
    style="
      --gallery-top-mob: {{ section.settings.gallery_top_mobile }}px;
      --gallery-bot-mob: {{ section.settings.gallery_bottom_mobile }}px;
      --gallery-top-desk: {{ section.settings.gallery_top_desktop }}px;
      --gallery-bot-desk: {{ section.settings.gallery_bottom_desktop }}px;
    "
  >
    <div class="manufacturing-gallery__inner page-width flex flex-col gap-4 lg:gap-6">
      {%- if gallery_heading_plain != blank -%}
        {%- render 'section-header', heading: gallery_heading, class_name: 'text-left' -%}
      {%- endif -%}

      {%- if gallery_live_count > 0 -%}
        <div class="manufacturing-gallery__grid grid grid-cols-2 gap-3 lg:grid-cols-3 lg:gap-5">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'gallery-tile' -%}
                {%- render 'gallery-tile', block: block -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Manufacturing Gallery",
  "class": "mfg-gallery-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "gallery_heading",
      "label": "Gallery Heading",
      "default": "<p>Manufacturing</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "gallery_top_mobile",
      "label": "Space Above (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gallery_bottom_mobile",
      "label": "Space Below (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gallery_top_desktop",
      "label": "Space Above (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gallery_bottom_desktop",
      "label": "Space Below (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "gallery-tile",
      "name": "Gallery Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "tile_image",
          "label": "Tile Image"
        },
        {
          "type": "text",
          "id": "tile_caption",
          "label": "Tile Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Manufacturing Gallery",
      "blocks": [
        { "type": "gallery-tile", "settings": { "tile_caption": "Annual Community Retreat 2025" } },
        { "type": "gallery-tile", "settings": { "tile_caption": "R&D Lab Sessions" } },
        { "type": "gallery-tile", "settings": { "tile_caption": "R&D Lab Sessions" } },
        { "type": "gallery-tile", "settings": { "tile_caption": "Autumn Campaign Shoot" } },
        { "type": "gallery-tile", "settings": { "tile_caption": "Global Health Expo Mumbai" } },
        { "type": "gallery-tile", "settings": { "tile_caption": "Wellness Wednesdays" } }
      ]
    }
  ]
}
{% endschema %}
