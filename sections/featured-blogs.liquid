{%- liquid
  assign blogs_heading = section.settings.blogs_heading
  assign blogs_heading_plain = blogs_heading | strip_html | strip
  assign blogs_label = blogs_heading_plain | default: 'Wellness, simplified.'

  assign blogs_article_count = 0
  for block in section.blocks
    if block.settings.blogs_article != blank
      assign blogs_article_count = blogs_article_count | plus: 1
    endif
  endfor
-%}

{%- if blogs_article_count > 0 -%}
  <div
    class="featured-blogs mt-[var(--blogs-top-mobile)] mb-[var(--blogs-bottom-mobile)] lg:mt-[var(--blogs-top-desktop)] lg:mb-[var(--blogs-bottom-desktop)]"
    style="
      --blogs-top-mobile: {{ section.settings.blogs_top_mobile }}px;
      --blogs-bottom-mobile: {{ section.settings.blogs_bottom_mobile }}px;
      --blogs-top-desktop: {{ section.settings.blogs_top_desktop }}px;
      --blogs-bottom-desktop: {{ section.settings.blogs_bottom_desktop }}px;
    "
  >
    <div class="page-width flex flex-col gap-5 lg:gap-6">
      {%- if blogs_heading_plain != blank -%}
        {%- render 'section-header',
          heading: blogs_heading,
          class_name: 'text-left text-section-heading lg:text-center lg:text-section-heading-d'
        -%}
      {%- endif -%}

      <div
        class="featured-blogs__viewport overflow-hidden"
        data-blogs-viewport
        data-carousel-label="{{ blogs_label | escape }}"
      >
        <div
          class="grid grid-flow-col auto-cols-[calc((100%-8px)/1.9)] gap-x-2 lg:auto-cols-[calc((100%-48px)/4)] lg:gap-x-4"
        >
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'article-block' -%}
                {%- if block.settings.blogs_article == blank -%}
                  {%- continue -%}
                {%- endif -%}

                {%- render 'article-card',
                  article: block.settings.blogs_article,
                  read_label: section.settings.blogs_read_label
                -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>

      {%- render 'button',
        label: 'View All Tips',
        link: section.settings.blogs_view_all_link,
        variant: 'secondary',
        size: 'xl',
        with_arrow: true,
        class_name: 'w-full lg:w-[316px] lg:mx-auto'
      -%}
    </div>
  </div>

  <script src="{{ 'featured-blogs.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Featured Blogs",
  "class": "featured-blogs-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "blogs_heading",
      "label": "Heading",
      "info": "Italicise a word to draw the smile underline.",
      "default": "<p>Wellness, <em>simplified.</em></p>"
    },
    {
      "type": "text",
      "id": "blogs_read_label",
      "label": "Read label",
      "info": "Applies to every card in this section.",
      "default": "Read"
    },
    {
      "type": "url",
      "id": "blogs_view_all_link",
      "label": "View all link",
      "info": "Where the View All Tips button goes."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "blogs_top_mobile",
      "label": "Space above (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "blogs_bottom_mobile",
      "label": "Space below (mobile)",
      "info": "Measured design exception; 44px is intentional.",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "blogs_top_desktop",
      "label": "Space above (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "blogs_bottom_desktop",
      "label": "Space below (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "article-block",
      "name": "Article Block",
      "settings": [
        {
          "type": "article",
          "id": "blogs_article",
          "label": "Article"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Blogs",
      "settings": {
        "blogs_view_all_link": "/blogs/news"
      },
      "blocks": [
        { "type": "article-block" },
        { "type": "article-block" },
        { "type": "article-block" },
        { "type": "article-block" }
      ]
    }
  ]
}
{% endschema %}
