{%- liquid
  assign values_heading = section.settings.values_heading
  assign values_heading_plain = values_heading | strip_html | strip

  assign values_live_count = 0
  for block in section.blocks
    assign values_desc_plain = block.settings.value_desc | strip_html | strip
    if block.settings.value_icon != blank or block.settings.value_title != blank or values_desc_plain != blank
      assign values_live_count = values_live_count | plus: 1
    endif
  endfor
-%}

{%- if values_heading_plain != blank or values_live_count > 0 -%}
  <div
    class="core-values mb-[var(--values-bot-mob)] mt-[var(--values-top-mob)] lg:mb-[var(--values-bot-desk)] lg:mt-[var(--values-top-desk)]"
    style="
      --values-top-mob: {{ section.settings.values_top_mobile }}px;
      --values-bot-mob: {{ section.settings.values_bottom_mobile }}px;
      --values-top-desk: {{ section.settings.values_top_desktop }}px;
      --values-bot-desk: {{ section.settings.values_bottom_desktop }}px;
    "
  >
    <div class="core-values__inner page-width flex flex-col gap-4 lg:gap-6">
      {%- if values_heading_plain != blank -%}
        {%- render 'section-header', heading: values_heading, class_name: 'text-left lg:text-center' -%}
      {%- endif -%}

      {%- if values_live_count > 0 -%}
        <div class="core-values__grid grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-5">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'core-value-card' -%}
                {%- render 'core-value-card', block: block -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Core Values",
  "class": "core-values-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "values_heading",
      "label": "Values Heading",
      "default": "<p>Our Core Values</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "values_top_mobile",
      "label": "Space Above (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "values_bottom_mobile",
      "label": "Space Below (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "values_top_desktop",
      "label": "Space Above (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "values_bottom_desktop",
      "label": "Space Below (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "core-value-card",
      "name": "Core Value Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "value_icon",
          "label": "Value Icon",
          "info": "PNG or SVG. Shown white on the yellow tile."
        },
        {
          "type": "text",
          "id": "value_title",
          "label": "Value Title"
        },
        {
          "type": "richtext",
          "id": "value_desc",
          "label": "Value Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Core Values",
      "blocks": [
        {
          "type": "core-value-card",
          "settings": {
            "value_title": "Trust",
            "value_desc": "<p>130+ years of earning it daily</p>"
          }
        },
        {
          "type": "core-value-card",
          "settings": {
            "value_title": "Simplicity",
            "value_desc": "<p>Wellness that is easy to use, every day.</p>"
          }
        },
        {
          "type": "core-value-card",
          "settings": {
            "value_title": "Care",
            "value_desc": "<p>For families, communities, and the planet.</p>"
          }
        },
        {
          "type": "core-value-card",
          "settings": {
            "value_title": "Innovation",
            "value_desc": "<p>Modern science rooted in 128 years of practice.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
