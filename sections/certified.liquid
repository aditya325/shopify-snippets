{%- liquid
  assign certified_heading = section.settings.certified_heading
  assign certified_logo_count = 0
  for block in section.blocks
    if block.settings.logo_image != blank
      assign certified_logo_count = certified_logo_count | plus: 1
    endif
  endfor

  assign certified_bg = section.settings.certified_bg
  assign certified_logo_h = section.settings.certified_logo_h | default: 70

  # a painted band needs padding of its own; margin falls outside the paint
  assign certified_band_class = ''
  if certified_bg != blank
    assign certified_band_class = ' py-6 lg:py-8'
  endif

  assign certified_style = section.settings.certified_style | default: 'caps'

  if certified_style == 'plain'
    assign certified_inner_class = 'certified__inner flex flex-col items-start gap-5'
    assign certified_heading_class = 'certified__heading w-full font-primary text-[12px]/[18px] font-medium uppercase tracking-[1px] text-muted lg:text-[14px]/[21px]'
  else
    assign certified_inner_class = 'certified__inner flex flex-col items-center gap-[30px] lg:items-start lg:gap-6'
    assign certified_heading_class = 'certified__heading font-secondary text-[12px]/[18px] font-semibold uppercase tracking-[1px] text-muted lg:text-[16px]/[26px]'
  endif

  assign certified_logo_class = 'h-[30px] w-auto lg:h-[var(--certified-logo-h)]'
-%}

{%- if certified_logo_count > 0 -%}
  <div
    class="certified mb-[var(--certified-bottom-mobile)] mt-[var(--certified-top-mobile)] lg:mb-[var(--certified-bottom-desktop)] lg:mt-[var(--certified-top-desktop)]{{ certified_band_class }}"
    style="
      --certified-top-mobile: {{ section.settings.certified_top_mobile }}px;
      --certified-bottom-mobile: {{ section.settings.certified_bottom_mobile }}px;
      --certified-top-desktop: {{ section.settings.certified_top_desktop }}px;
      --certified-bottom-desktop: {{ section.settings.certified_bottom_desktop }}px;
      --certified-logo-h: {{ certified_logo_h }}px;
      {% if certified_bg != blank %}background-color: {{ certified_bg }};{% endif %}
    "
  >
    <div class="page-width">
      <div class="{{ certified_inner_class }}">
      {%- if certified_heading != blank -%}
        <p class="{{ certified_heading_class }}">
          {{ certified_heading | escape }}
        </p>
      {%- endif -%}

      <div class="certified__row flex w-full items-start justify-between">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'certified-logo' -%}
              {%- render 'certified-logo', block: block, logo_class: certified_logo_class -%}
          {%- endcase -%}
        {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Certified",
  "class": "certified-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "certified_heading",
      "label": "Heading",
      "default": "Certified, Tested & Trusted",
      "info": "Small heading above the marks. Example: Certified, Tested & Trusted. Leave empty to show the marks on their own."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "certified_bg",
      "label": "Certified Bg",
      "info": "Blank leaves the band unpainted."
    },
    {
      "type": "select",
      "id": "certified_style",
      "label": "Certified Style",
      "info": "Compact uses Space Grotesk Medium at tighter spacing.",
      "options": [
        { "value": "caps", "label": "Standard subtitle" },
        { "value": "plain", "label": "Compact subtitle" }
      ],
      "default": "caps"
    },
    {
      "type": "range",
      "id": "certified_logo_h",
      "label": "Certified Logo H",
      "info": "Desktop logo height.",
      "min": 20,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "certified_top_mobile",
      "label": "Space above (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "certified_bottom_mobile",
      "label": "Space below (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "certified_top_desktop",
      "label": "Space above (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "certified_bottom_desktop",
      "label": "Space below (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "certified-logo",
      "name": "Certified Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Image",
          "info": "The certification mark. Example: an FSSAI or ISO seal. Leave empty to hide this logo."
        },
        {
          "type": "text",
          "id": "logo_alt",
          "label": "Alt text",
          "info": "Describes the mark to screen readers. Example: ISO 9001:2015. Leave empty if the mark is decorative."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Certified",
      "blocks": [
        {
          "type": "certified-logo",
          "settings": {
            "logo_image": "shopify://shop_images/certified-fssai.png",
            "logo_alt": "FSSAI"
          }
        },
        {
          "type": "certified-logo",
          "settings": {
            "logo_image": "shopify://shop_images/certified-ayush.png",
            "logo_alt": "Ministry of AYUSH"
          }
        },
        {
          "type": "certified-logo",
          "settings": {
            "logo_image": "shopify://shop_images/certified-gmp.png",
            "logo_alt": "GMP Good Manufacturing Practice"
          }
        },
        {
          "type": "certified-logo",
          "settings": {
            "logo_image": "shopify://shop_images/certified-cruelty-free.png",
            "logo_alt": "Cruelty Free"
          }
        },
        {
          "type": "certified-logo",
          "settings": {
            "logo_image": "shopify://shop_images/certified-iso-9001.png",
            "logo_alt": "ISO 9001:2015"
          }
        }
      ]
    }
  ]
}
{% endschema %}
