{%- liquid
  assign tabs_collections = section.settings.tabs_collections

  assign tabs_visible_count = 0
  for tabs_collection in tabs_collections
    if tabs_collection.products.size > 0
      assign tabs_visible_count = tabs_visible_count | plus: 1
    endif
  endfor
-%}

{%- if tabs_visible_count > 0 -%}
  <div
    class="tabbed-product-collection mt-[var(--tabs-space-above-mobile)] mb-[var(--tabs-space-below-mobile)] lg:mt-[var(--tabs-space-above-desktop)] lg:mb-[var(--tabs-space-below-desktop)]"
    style="
      --tabs-space-above-mobile: {{ section.settings.tabs_space_above_mobile }}px;
      --tabs-space-below-mobile: {{ section.settings.tabs_space_below_mobile }}px;
      --tabs-space-above-desktop: {{ section.settings.tabs_space_above_desktop }}px;
      --tabs-space-below-desktop: {{ section.settings.tabs_space_below_desktop }}px;
    "
  >
    <div class="bg-accent/10 py-6 lg:bg-accent/20 lg:py-8">
      <div class="page-width flex flex-col items-center gap-5 lg:gap-6">
        <div
          class="flex flex-wrap justify-center gap-6 lg:gap-10"
          role="tablist"
          aria-label="{{ 'accessibility.product_tabs' | t }}"
        >
          {%- assign tabs_index = 0 -%}
          {%- for tabs_collection in tabs_collections -%}
            {%- if tabs_collection.products.size == 0 -%}
              {%- continue -%}
            {%- endif -%}

            {%- liquid
              assign tabs_index = tabs_index | plus: 1
              assign tabs_is_selected = 'false'
              assign tabs_tabindex = '-1'
              if tabs_index == 1
                assign tabs_is_selected = 'true'
                assign tabs_tabindex = '0'
              endif
            -%}

            <button
              id="tab-{{ section.id }}-{{ tabs_index }}"
              class="font-primary text-section-heading font-semibold text-foreground/40 transition-colors aria-selected:text-foreground lg:text-section-heading-d lg:font-bold max-374:text-[22px]"
              type="button"
              role="tab"
              aria-controls="panel-{{ section.id }}-{{ tabs_index }}"
              aria-selected="{{ tabs_is_selected }}"
              tabindex="{{ tabs_tabindex }}"
              data-tab
            >
              {{- tabs_collection.title -}}
            </button>
          {%- endfor -%}
        </div>

        {%- assign tabs_index = 0 -%}
        {%- for tabs_collection in tabs_collections -%}
          {%- if tabs_collection.products.size == 0 -%}
            {%- continue -%}
          {%- endif -%}

          {%- liquid
            assign tabs_index = tabs_index | plus: 1
            assign tabs_hidden = 'hidden'
            if tabs_index == 1
              assign tabs_hidden = ''
            endif
          -%}

          <div
            id="panel-{{ section.id }}-{{ tabs_index }}"
            class="flex w-full flex-col items-center gap-5 lg:gap-6"
            role="tabpanel"
            aria-labelledby="tab-{{ section.id }}-{{ tabs_index }}"
            data-tab-panel
            {{ tabs_hidden }}
          >
            <div class="grid w-full grid-cols-2 gap-2.5 lg:grid-cols-4 lg:gap-5">
              {%- for tabs_product in tabs_collection.products limit: 4 -%}
                {%- render 'product-card',
                  card_product: tabs_product,
                  show_featured_image: section.settings.tabs_use_featured_image
                -%}
              {%- endfor -%}
            </div>

            {%- render 'button',
              label: section.settings.tabs_view_all_label,
              link: tabs_collection.url,
              variant: 'secondary',
              size: '2xl',
              with_arrow: true,
              class_name: 'w-full lg:w-[330px]',
              icon_class: 'h-3.5 w-3.5 icon--stroke-bold lg:h-[18px] lg:w-[18px]'
            -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script src="{{ 'tabbed-product-collection.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Tabbed Products",
  "class": "tabbed-products-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "collection_list",
      "id": "tabs_collections",
      "label": "Collections",
      "info": "One tab per collection, named after the collection. Collections with no products are skipped.",
      "limit": 3
    },
    {
      "type": "checkbox",
      "id": "tabs_use_featured_image",
      "label": "Use featured image",
      "info": "Off uses the product's Card image metafield and its Radiator image artwork instead.",
      "default": true
    },
    {
      "type": "text",
      "id": "tabs_view_all_label",
      "label": "View all button text",
      "info": "The link goes to whichever collection tab is open.",
      "default": "View All"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "tabs_space_above_mobile",
      "label": "Space above (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "tabs_space_below_mobile",
      "label": "Space below (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "tabs_space_above_desktop",
      "label": "Space above (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "tabs_space_below_desktop",
      "label": "Space below (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Tabbed Products"
    }
  ]
}
{% endschema %}
