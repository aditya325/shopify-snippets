{%- liquid
  assign claims_heading = section.settings.claims_heading
  assign claims_heading_plain = claims_heading | strip_html | strip
  assign claims_has_blocks = false
  if section.blocks.size > 0
    assign claims_has_blocks = true
  endif

  assign claims_style = section.settings.claims_style | default: 'badge'

  if claims_style == 'stat'
    assign claims_inner_class = 'page-width flex flex-col gap-4 lg:gap-5'
    assign claims_header_class = 'text-left text-foreground'
    if section.settings.claims_mob_grid
      assign claims_row_class = 'grid w-full grid-cols-2 items-center gap-3 lg:flex lg:justify-between lg:gap-3'
    else
      assign claims_row_class = 'flex w-full items-center justify-between gap-3'
    endif
  else
    assign claims_inner_class = 'page-width flex flex-col items-center gap-6 lg:flex-row lg:justify-center lg:gap-40'
    assign claims_header_class = 'text-center lg:shrink-0 lg:text-left'
    assign claims_row_class = 'flex w-full items-center justify-between gap-2.5 lg:flex-1'
  endif
-%}

{%- if claims_heading_plain != blank or claims_has_blocks -%}
  <div
    class="claims mb-[var(--claims-bottom-mobile)] mt-[var(--claims-top-mobile)] lg:mb-[var(--claims-bottom-desktop)] lg:mt-[var(--claims-top-desktop)]"
    style="
      --claims-top-mobile: {{ section.settings.claims_top_mobile }}px;
      --claims-bottom-mobile: {{ section.settings.claims_bottom_mobile }}px;
      --claims-top-desktop: {{ section.settings.claims_top_desktop }}px;
      --claims-bottom-desktop: {{ section.settings.claims_bottom_desktop }}px;
    "
  >
    <div class="{{ claims_inner_class }}">
      {%- if claims_heading_plain != blank -%}
        {%- render 'section-header', heading: claims_heading, class_name: claims_header_class -%}
      {%- endif -%}

      {%- if claims_has_blocks -%}
        <div class="{{ claims_row_class }}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'claim-item' -%}
                {%- render 'claim-item', block: block, claim_style: claims_style -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Claims",
  "class": "claims-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "claims_heading",
      "label": "Heading",
      "info": "Italicise a word to draw the smile underline.",
      "default": "<p>Trusted By <em>Millions</em></p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "claims_style",
      "label": "Claims Style",
      "options": [
        { "value": "badge", "label": "Badge (green caps)" },
        { "value": "stat", "label": "Stat (gold figures)" }
      ],
      "default": "badge"
    },
    {
      "type": "checkbox",
      "id": "claims_mob_grid",
      "label": "Claims Mob Grid",
      "info": "Two by two on mobile, with a rule under the heading. Stat style only.",
      "default": false
    },
    {
      "type": "range",
      "id": "claims_top_mobile",
      "label": "Space above (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "claims_bottom_mobile",
      "label": "Space below (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "claims_top_desktop",
      "label": "Space above (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "claims_bottom_desktop",
      "label": "Space below (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "claim-item",
      "name": "Claim Item",
      "settings": [
        {
          "type": "text",
          "id": "claim_value",
          "label": "Value"
        },
        {
          "type": "richtext",
          "id": "claim_title",
          "label": "Title",
          "info": "Enter starts a new line on mobile. Lines join on desktop."
        },
        {
          "type": "checkbox",
          "id": "claim_show_plus",
          "label": "Show plus sign",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "claim_show_star",
          "label": "Show star",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Claims",
      "blocks": [
        {
          "type": "claim-item",
          "settings": {
            "claim_value": "4.8",
            "claim_title": "<p>Average<br />ratings</p>",
            "claim_show_plus": false,
            "claim_show_star": true
          }
        },
        {
          "type": "claim-item",
          "settings": {
            "claim_value": "2M",
            "claim_title": "<p>Happy<br />customers</p>",
            "claim_show_plus": true
          }
        },
        {
          "type": "claim-item",
          "settings": {
            "claim_value": "130",
            "claim_title": "<p>Years<br />trusted</p>",
            "claim_show_plus": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
