{%- liquid
  assign icon_size = size | default: 20

  capture icon_class_attr
    if class != blank
      echo ' class="'
      echo class
      echo '"'
    endif
  endcapture
-%}
<svg{{ icon_class_attr }} width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <polyline points="20 6 9 17 4 12"/>
</svg>
