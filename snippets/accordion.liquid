{% doc %}
  Reusable Accordion Component

  @param {string} title - The clickable title/header text
  @param {string} content - The HTML content to show/hide
  @param {string} [unique_id] - Unique identifier to prevent duplicate IDs
  @param {string} [class_name] - Additional CSS classes for the wrapper
  @param {string} [title_class] - Additional CSS classes for the trigger button
  @param {string} [content_class] - Additional CSS classes for the content inner
  @param {boolean} [default_open] - Whether accordion starts open (default: false)
  @param {string} [icon_type] - Icon style: 'plus-minus' (default) or 'chevron'
  @param {number} [icon_size] - Chevron size in pixels (default: 12). chevron only
  @param {string} [icon_box_class] - Sizing classes for the icon box (default: 'h-6 w-6'). chevron only
  @param {string} [icon_name] - Chevron glyph: 'chevron-down' (default) or 'caret-down'. chevron only
{% enddoc %}

{%- liquid
  assign accordion_title_handle = title | strip_html | handleize

  if unique_id != blank
    assign accordion_suffix = unique_id
  else
    assign accordion_suffix = 'now' | date: '%s%N'
  endif

  assign accordion_id = 'accordion-' | append: accordion_title_handle | append: '-' | append: accordion_suffix
  assign is_open = default_open | default: false
  assign icon_type = icon_type | default: 'plus-minus'
  assign accordion_icon_size = icon_size | default: 12
  assign accordion_icon_box_class = icon_box_class | default: 'h-6 w-6'
  assign accordion_icon_name = icon_name | default: 'chevron-down'
-%}

<div class="accordion {{ class_name }}" data-accordion>
  <button
    class="accordion__trigger flex w-full cursor-pointer items-center justify-between text-left {{ title_class }}"
    type="button"
    aria-expanded="{{ is_open }}"
    aria-controls="{{ accordion_id }}-content"
    data-accordion-trigger
  >
    <span class="accordion__title min-w-0 flex-1">{{ title }}</span>
    {%- if icon_type == 'chevron' -%}
      <span
        class="accordion__icon flex shrink-0 items-center justify-center transition-transform duration-300 {{ accordion_icon_box_class }} {% if is_open %}rotate-180{% endif %}"
        data-accordion-icon
        data-accordion-icon-type="chevron"
      >
        {%- case accordion_icon_name -%}
          {%- when 'caret-down' -%}
            {% render 'icon-caret-down', class: accordion_icon_box_class %}
          {%- else -%}
            {% render 'icon-chevron-down', size: accordion_icon_size, class: '' %}
        {%- endcase -%}
      </span>
    {%- else -%}
      <span
        class="accordion__icon flex h-6 w-6 items-center justify-center transition-transform duration-300"
        data-accordion-icon
        data-accordion-icon-type="plus-minus"
      >
        <span class="accordion__icon-plus {% if is_open %}hidden{% endif %}" data-accordion-icon-plus>
          {% render 'icon-plus', class: 'h-4 w-4' %}
        </span>
        <span class="accordion__icon-minus {% unless is_open %}hidden{% endunless %}" data-accordion-icon-minus>
          {% render 'icon-minus', size: 16 %}
        </span>
      </span>
    {%- endif -%}
  </button>
  <div
    class="accordion__content overflow-hidden transition-all duration-300 {% if is_open == false %}max-h-0{% endif %}"
    id="{{ accordion_id }}-content"
    data-accordion-content
    aria-hidden="{% if is_open %}false{% else %}true{% endif %}"
  >
    <div class="accordion__content-inner {{ content_class }}">
      {{ content }}
    </div>
  </div>
</div>
