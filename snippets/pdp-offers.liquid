{% doc %}
  PDP Offers

  "Available Offers" card row. Horizontal scroll with snap so each card comes to rest aligned — no
  arrows, because none are drawn.

  Mobile and desktop differ on nearly every value, so both are stated here:
  panel pad 10/radius 12 -> 14/20, card 240 wide/pad 12 -> 352/pad 14-16, headline 14/21 -> 16/21,
  subtitle 12/16 -> 12/17, footer radius 6 -> 8, description weight 400 -> 500.
  (544:32657 mobile, 544:24456 desktop.)

  Card chrome measured from a canvas render, not the node dump: the design's `inner_shadow: 3,0` as a
  3px inset #466e2e stripe, a dashed footer outline, and a two-colour code label. The 1px gradient ring
  and the footer's dashed ring live in product.css — both are Figma INSIDE strokes, so neither may
  occupy box-model space.

  @param {object[]} offers - offer metaobject entries (required)
  @param {string} [heading] - Section heading (default: 'Available Offers')
{% enddoc %}

{%- liquid
  assign offers_list = offers | default: blank

  unless offers_list != blank
    break
  endunless

  assign offers_heading = heading | default: 'Available Offers'

  assign offers_headline_class = 'bg-[linear-gradient(93.4deg,#84CC16_-9.49%,#365314_39.79%),linear-gradient(0deg,#171717,#171717)] bg-clip-text font-secondary text-[14px]/[21px] font-extrabold text-foreground [-webkit-background-clip:text] [-webkit-text-fill-color:transparent] lg:text-[16px]/[21px]'
-%}

<div class="pdp-offers flex flex-col gap-4 rounded-xl bg-primary/10 p-2.5 lg:rounded-[20px] lg:p-3.5">
  <div class="flex flex-col gap-1">
    <span class="font-secondary text-[14px]/[18px] font-medium text-foreground lg:text-[18px]/[28px]">
      {{ offers_heading | escape }}
    </span>
    <span class="font-secondary text-[12px]/[16px] text-[#757575] lg:font-medium">
      Apply these coupon codes at checkout to claim your discounts and gifts
    </span>
  </div>

  <div class="pdp-offers__track flex snap-x snap-mandatory items-center gap-[13px] overflow-x-auto scrollbar-hide">
    {%- for offer in offers_list -%}
      <div
        class="pdp-offers__card flex shrink-0 basis-[240px] snap-start flex-col gap-[14px] rounded-xl bg-white p-3 shadow-[inset_3px_0_0_0_rgb(var(--color-primary))] lg:basis-[352px] lg:px-4 lg:py-3.5"
      >
        <div class="flex flex-col gap-0.5">
          {%- if offer.title != blank -%}
            <span class="{{ offers_headline_class }}">{{ offer.title }}</span>
          {%- endif -%}

          {%- if offer.description != blank -%}
            <span class="font-secondary text-[12px]/[16px] font-medium text-[#757575] lg:text-[12px]/[17px]">
              {{ offer.description }}
            </span>
          {%- endif -%}
        </div>

        {%- if offer.code != blank -%}
          <div
            class="pdp-offers__code flex items-center justify-between rounded-md bg-primary/[0.06] py-1 pl-2.5 pr-1.5 lg:rounded-lg"
          >
            <span class="font-secondary text-[13px]/[16px] font-semibold text-[#1a1a1a]">
              Use code:
              <span class="text-primary">{{ offer.code }}</span>
            </span>

            <button
              type="button"
              class="pdp-offers__copy grid shrink-0 place-items-center rounded-md bg-primary px-2.5 py-1.5 font-secondary text-[12px]/[16px] font-bold text-white"
              data-offer-copy
              data-offer-code="{{ offer.code | escape }}"
              aria-label="Copy code {{ offer.code | escape }}"
            >
              {%- comment -%} COPY alone sizes the chip to Figma's 54px; the check is narrower so it cannot widen it {%- endcomment -%}
              <span class="pdp-offers__copy-label" aria-hidden="true">COPY</span>
              <span class="pdp-offers__copy-label pdp-offers__copy-label--done" aria-hidden="true">
                {%- render 'icon-checkmark', size: 16 -%}
              </span>
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <textarea class="sr-only" tabindex="-1" aria-hidden="true" readonly data-offer-clipboard></textarea>
</div>
