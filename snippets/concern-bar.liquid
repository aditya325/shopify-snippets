{% doc %}
  Concern Bar

  Tinted band of concern chips injected between product rows. Chips are filter
  toggles, not links — each carries the storefront filter's own add/remove URL and
  `data-active-filter`, so assets/collection.js applies them without a page reload.

  Sourced from whichever filter group's values target the `custom.concerns`
  metafield, so it disappears cleanly when that facet is not configured.

  @param {object} filter_source - Object exposing .filters (required)

  @example
  {% render 'concern-bar', filter_source: collection %}
{% enddoc %}

{%- liquid
  assign filter_source = filter_source | default: blank

  unless filter_source != blank
    break
  endunless

  assign concern_filter = blank
  for filter in filter_source.filters
    if filter.type == 'list' and filter.param_name contains 'custom.concerns'
      assign concern_filter = filter
      break
    endif
  endfor

  unless concern_filter != blank and concern_filter.values.size > 0
    break
  endunless
-%}

<div class="concern-bar flex flex-col gap-2.5 rounded-md bg-primary/20 p-3 lg:gap-3.5 lg:rounded-[20px] lg:px-3.5 lg:py-3">
  <h2 class="font-primary text-[12px] font-bold leading-[15.3px] tracking-normal text-foreground lg:text-[16px] lg:leading-[20.4px]">
    {{ 'facets.shop_by_concern' | t }}
  </h2>

  <div class="flex flex-wrap gap-2">
    {%- for value in concern_filter.values -%}
      {%- if value.count > 0 or value.active -%}
        {%- if value.active -%}
          {%- assign concern_url = value.url_to_remove -%}
          {%- assign concern_state_class = 'border-accent bg-accent/15' -%}
        {%- else -%}
          {%- assign concern_url = value.url_to_add -%}
          {%- assign concern_state_class = 'border-[#f5f5f5] bg-background [@media(hover:hover)]:hover:border-primary' -%}
        {%- endif -%}

        <a
          href="{{ concern_url }}"
          class="flex-1 flex h-7 shrink-0 items-center justify-center whitespace-nowrap rounded-md border px-4 font-secondary text-[12px] font-medium leading-4 tracking-[-0.12px] text-foreground transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary lg:h-[33px] lg:flex-1 lg:basis-0 lg:rounded-lg lg:text-[14px] lg:leading-[21px] lg:tracking-normal {{ concern_state_class }}"
          data-active-filter
          {% if value.active %}
            aria-current="true"
          {% endif %}
        >
          <span>{{ value.label | escape }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
