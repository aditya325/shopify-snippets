{% doc %}
  Lock Icon

  Padlock shown on a milestone badge that has not been reached. Exported from Figma at 18×18 with a
  1.2 stroke; recoloured through `currentColor` so the badge's own text colour drives it.

  @param {string} [class] - Additional CSS classes (optional)
  @param {number} [size] - Icon size in pixels (default: 18)

  @example
  {% render 'icon-lock', size: 18, class: 'text-[#FACC15]' %}
{% enddoc %}

{%- assign icon_size = size | default: 18 -%}
<svg
  class="{{ class }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 18 18"
  fill="none"
  stroke="currentColor"
  stroke-width="1.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
