{% doc %}
  Back to Top Button

  Renders a floating back-to-top button inside a <back-to-top> custom element
  that becomes visible after scrolling past one full viewport height and scrolls
  the page back to the top when activated.

  @example
  {% render 'back-to-top' %}
{% enddoc %}

{{ 'back-to-top.css' | asset_url | stylesheet_tag }}

<back-to-top class="back-to-top" data-back-to-top aria-hidden="true">
  <button
    type="button"
    class="back-to-top__button"
    data-back-to-top-button
    aria-label="{{ 'accessibility.back_to_top' | t | escape }}"
    tabindex="-1"
    disabled
  >
    <svg
      class="back-to-top__icon"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>
</back-to-top>

<script src="{{ 'back-to-top.js' | asset_url }}" defer></script>
