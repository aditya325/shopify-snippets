{% doc %}
  The left rail of one mega-menu panel — a title and the tablist holding its rows.

  @param {string} [panel_title] - Rail heading. Omitted when blank
  @param {string} rows - Pre-rendered mega-menu-rail-row markup, in menu order
{% enddoc %}

<div class="mega-menu__rail flex min-w-0 flex-[55] flex-col gap-4">
  {%- if panel_title != blank -%}
    <h2 class="font-primary text-[16px]/[24px] font-medium text-foreground">{{ panel_title | escape }}</h2>
  {%- endif -%}

  <div class="flex flex-col" role="tablist" aria-orientation="vertical">
    {{ rows }}
  </div>
</div>
