{% doc %}
  One benefit card in the Description panel; icon is an uploaded image (Shopify Files) set on the benefit metaobject (544:24548 / 544:32750).

  @param {object} benefit - A benefit metaobject entry (required)
{% enddoc %}

{%- if benefit.title != blank -%}
  {%- assign benefit_icon = benefit.icon.value -%}
  <div
    class="pdp-benefit flex flex-col gap-3 rounded-xl bg-[#f9f5ee] p-2.5 outline outline-[0.5px] -outline-offset-[0.5px] outline-accent lg:gap-4 lg:rounded-[20px]"
  >
    {%- if benefit_icon != blank -%}
      <div class="pdp-benefit__icon size-[30px] shrink-0 overflow-hidden rounded-md lg:size-[46px] lg:rounded-xl">
        {{-
          benefit_icon
          | image_url: width: 138
          | image_tag:
            class: 'pdp-benefit__icon-image',
            alt: '',
            loading: 'lazy',
            width: 46,
            height: 46
        -}}
      </div>
    {%- endif -%}

    <div class="flex flex-col gap-0.5 lg:gap-1">
      <span
        class="text-[14px]/[21px] font-medium tracking-[-0.16px] text-foreground lg:text-[20px]/[30px] lg:tracking-normal"
      >
        {{ benefit.title | escape }}
      </span>

      {%- if benefit.description != blank -%}
        <span class="text-label-sm text-[#6e6e6e] lg:text-[16px]/[24px] lg:tracking-normal">
          {{ benefit.description | escape }}
        </span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
