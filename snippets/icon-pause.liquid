{% doc %}
  Pause Icon

  Two rounded bars matching icon-play's 27x27 box, corner softness and vertical extent, so the pair
  swap without the control shifting weight. Colour comes from the parent's text utility.

  @param {string} [class] - Sizing classes (optional)
{% enddoc %}

<svg
  class="icon {{ class }}"
  viewBox="0 0 27 27"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <rect x="7.6" y="5.3" width="4.4" height="16.4" rx="1.75"/>
  <rect x="15" y="5.3" width="4.4" height="16.4" rx="1.75"/>
</svg>
