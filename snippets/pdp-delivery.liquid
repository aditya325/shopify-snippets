{% doc %}
  PDP Delivery

  Pincode field and its checked state. Both states are pre-rendered and toggled with the hidden
  attribute, so product.js swaps them rather than building DOM. The checked state mirrors the
  input's bordered box and green button (544:28105 / 544:28112), not a bare text link.

  Display only — F2 says this is not a serviceability check, so the copy must never imply one.

  @param {string} [heading] - Block heading (default: 'Delivery Details')
  @param {string} [subtext] - Line under the heading
  @param {string} date_from - Window start, already formatted (required)
  @param {string} date_to - Window end, already formatted (required)
{% enddoc %}

{%- liquid
  assign delivery_heading = heading | default: 'Delivery Details'
  assign delivery_subtext = subtext | default: 'Check delivery availability and estimated delivery date'
  assign delivery_box_class = 'flex grow items-center gap-2.5 rounded-[10px] bg-white p-2 ring-1 ring-inset ring-border'
  assign delivery_checked_box_class = 'flex grow items-start gap-2.5 rounded-[10px] bg-white px-3 py-2.5 ring-1 ring-inset ring-border'
  assign delivery_button_class = 'relative flex shrink-0 items-center justify-center self-stretch rounded-[10px] bg-primary px-4 py-3 font-secondary text-[14px]/[18px] font-bold text-white disabled:opacity-70'
-%}

<div class="pdp-delivery flex flex-col gap-4 lg:pb-10" data-pdp-delivery>
  <div class="flex flex-col gap-1">
    <span class="font-secondary text-[14px]/[18px] font-medium text-foreground lg:text-[18px]/[28px]">
      {{ delivery_heading | escape }}
    </span>

    {%- if delivery_subtext != blank -%}
      <span class="font-secondary text-[12px]/[16px] text-[#757575] lg:font-medium">
        {{- delivery_subtext | escape -}}
      </span>
    {%- endif -%}
  </div>

  <div class="flex items-center gap-3" data-delivery-input-state>
    <div class="{{ delivery_box_class }}">
      <span
        class="grid size-[30px] shrink-0 place-items-center rounded-[5px] bg-gradient-to-br from-[#84cc16]/10 to-[#365314]/10 lg:size-9"
      >
        {%- render 'icon-truck', class: 'size-[18px] text-primary [stroke-width:1.3] lg:size-[22px]' -%}
      </span>

      <input
        type="text"
        inputmode="numeric"
        maxlength="6"
        autocomplete="postal-code"
        placeholder="Enter Pincode"
        aria-label="Delivery pincode"
        class="w-full bg-transparent font-secondary text-[14px]/[18px] font-medium text-foreground outline-none placeholder:text-[#9ca3af]"
        data-delivery-pincode
      >
    </div>

    <button type="button" class="{{ delivery_button_class }}" disabled data-delivery-check>
      <span data-delivery-check-label>Check</span>
      <span class="absolute inset-0 hidden place-items-center" data-delivery-check-loader>
        <span class="loader text-white"></span>
      </span>
    </button>
  </div>

  <p
    class="font-secondary text-[12px]/[16px] font-medium text-error"
    role="status"
    aria-live="polite"
    hidden
    data-delivery-error
  >
    Enter a 6-digit pincode.
  </p>

  <div class="flex items-center gap-3" hidden data-delivery-checked-state>
    <div class="{{ delivery_checked_box_class }}">
      <span class="grid size-5 shrink-0 place-items-center rounded-full bg-primary">
        {%- render 'icon-checkmark', class: 'size-4 text-white [stroke-width:1.3]' -%}
      </span>

      <span class="flex flex-col gap-[3px]">
        <span class="font-secondary text-[10px]/[13px] font-medium text-foreground">
          Delivering to
          <span data-delivery-pincode-out></span>
        </span>
        <span class="font-secondary text-[12px]/[16px] font-medium text-foreground">
          Estimated Delivery by {{ date_from }} - {{ date_to }}
        </span>
      </span>
    </div>

    <button type="button" class="{{ delivery_button_class }}" data-delivery-change>Change Pincode</button>
  </div>
</div>
