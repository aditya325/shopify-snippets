{% doc %}
  Loader Icon

  Eight tapered bars fading around the circle, spun by animation. Matches the PLP
  loader, which is a group of graduated greys rather than a single arc.

  @param {number} [size] - Square size in pixels (default: 32)
  @param {string} [class] - Sizing classes (optional)
{% enddoc %}

{%- assign icon_size = size | default: 32 -%}
<svg
  class="animate-spin {{ class }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
>
  <g stroke-linecap="round" stroke-width="3">
    <line x1="16" y1="3" x2="16" y2="9" stroke="#737373"/>
    <line x1="25.2" y1="6.8" x2="21" y2="11" stroke="#7d7d7d"/>
    <line x1="29" y1="16" x2="23" y2="16" stroke="#919191"/>
    <line x1="25.2" y1="25.2" x2="21" y2="21" stroke="#a5a5a5"/>
    <line x1="16" y1="29" x2="16" y2="23" stroke="#b9b9b9"/>
    <line x1="6.8" y1="25.2" x2="11" y2="21" stroke="#c4c4c4"/>
    <line x1="3" y1="16" x2="9" y2="16" stroke="#cdcdcd"/>
    <line x1="6.8" y1="6.8" x2="11" y2="11" stroke="#dcdcdc"/>
  </g>
</svg>
