{% doc %}
  Clock Icon

  @param {string} [class] - Additional CSS classes (optional)
  @param {number} size - Icon size in pixels (default: 20)
{% enddoc %}

{%- assign icon_size = size | default: 20 -%}
<svg
  class="{{ class }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <circle cx="12" cy="12" r="9"/>
  <path d="M12 7.5V12l3.5 2"/>
</svg>
