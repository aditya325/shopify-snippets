{% doc %}
  Bundle Row

  One popular-bundle card in the Combo pane — name, "From" price and a link to the product. Stacks
  vertically in the 322px desktop column and sits in the mobile scroll track; the caller owns the slot
  width, this snippet only fills it.

  The price is wrapped in whitespace-nowrap so a long money string breaks after "From" rather than
  splitting into "Rs." / "1,499" — the failure product-card documents for this store's money format.

  @param {product} row_product - Product to render (required)
  @param {string} [row_cta_label] - Link label, from the bundle CTA setting; the link is omitted when blank
{% enddoc %}

{%- liquid
  assign row_product = row_product | default: blank

  unless row_product != blank
    break
  endunless

  assign row_cta_label = row_cta_label | default: ''
-%}

{%- capture row_price_html -%}
  <span class="whitespace-nowrap">{{ row_product.price_min | money_without_trailing_zeros }}</span>
{%- endcapture -%}

<div class="bundle-row relative flex h-full flex-col justify-between rounded-[15px] border border-[#e0e0e0] bg-white p-3.5 transition-[transform,box-shadow,border-color] duration-300 motion-reduce:transition-none [@media(hover:hover)]:hover:-translate-y-0.5 [@media(hover:hover)]:hover:border-[#1e5631] [@media(hover:hover)]:hover:shadow-[0_6px_16px_rgba(30,86,49,0.10)] lg:rounded-[12px]">
  <div class="bundle-row__details flex flex-col gap-1.5">
    <p class="bundle-row__title text-[14px]/[18px] font-bold text-black">{{ row_product.title | escape }}</p>

    <p class="bundle-row__price text-[16px]/[21px] font-bold text-[#1e5631]">
      {{- 'products.from_price_html' | t: price: row_price_html -}}
    </p>
  </div>

  {%- if row_cta_label != blank -%}
    <a
      class="bundle-row__link text-[12px]/[16px] font-semibold text-[#1e5631] underline after:absolute after:inset-0"
      href="{{ row_product.url }}"
    >
      {{- row_cta_label | escape -}}
    </a>
  {%- endif -%}
</div>
